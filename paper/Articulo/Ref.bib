@INPROCEEDINGS{11291374,
  author={Jayaprakash, Asha and Manuel, Manju and George, Michael},
  booktitle={2025 International Conference on Power, Instrumentation, Control, and Computing (PICC)}, 
  title={Performance Evaluation of YOLO v10, v11, and v12 Algorithms in Nutmeg Fruit Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Advancements in machine learning techniques have resulted in improvement in productivity in agriculture sector. This is due to the automation of agricultural processes like cultivation, planting, irrigation, fertilization, and harvesting. Only limited research has addressed nutmeg detection, as most existing studies focus on staple crops or high-value fruits. This paper investigates the performance evaluation of $\mathbf{v 1 0}$, v11, and v12 versions of YOLO for nutmeg fruit detection. Major challenge that affects the performance in nutmeg fruit detection is the occlusion made by the leaves and branches of nutmeg tree. A dedicated nutmeg dataset has been created for training and validation. YOLOv11 achieved the highest precision of 93.7 % whereas highest recall of 77.7 % is obtained in YOLOv10. The F1-scores obtained for YOLOv12, YOLOv11, and YOLOv10 are $83.3 \%, 82.6 \%$, and 81.5 % respectively. YOLOv10 and YOLOv12 each demand 6.5 GFLOPs, whereas YOLOv11 requires 6.3 GFLOPs. These insights provide valuable guidance for selecting the most appropriate YOLO model to optimize automation and productivity in agricultural practices. YOLO models are found to be very effective in achieving high accuracy and real-time performance in detecting nutmeg under challenging environments like varying lighting conditions and complex backgrounds.},
  keywords={YOLO;Training;Productivity;Performance evaluation;Accuracy;Automation;Trees (botanical);Lighting;Real-time systems;Reliability;Deep learning;YOLO;nutmeg dataset;object detection;precision;accuracy},
  doi={10.1109/PICC67314.2025.11291374},
  ISSN={2996-3087},
  month={Oct},}
@INPROCEEDINGS{11016889,
  author={Valdez, Daryl B.},
  booktitle={2025 IEEE Open Conference of Electrical, Electronic and Information Sciences (eStream)}, 
  title={Optimized Fruit Detection in Complex Environments Using YOLOv11n for Smart Agricultural Applications}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={This study explores the application of the YOLOv11 object detection algorithm for precise and efficient fruit detection in complex image environments. The research focuses on leveraging YOLOv11’s advanced single-stage detection architecture and Transfer Learning to enable real-time fruit identification while maintaining high detection accuracy, particularly for edge computing scenarios where computational efficiency is essential. To evaluate the effectiveness of the proposed system, the model was trained on a specialized fruit dataset consisting of images taken from real-world agricultural settings. The dataset comprises eleven distinct fruit classes captured under diverse conditions, including varying lighting, occlusions, and different angles. Experimental results revealed that the model achieved a mean average precision (mAP) of 90%, demonstrating its ability to localize and classify fruits with a high degree of reliability. The findings of this study have significant implications for the agricultural sector, particularly in automation-driven applications such as fruit harvesting, post-harvest processing, quality assessment, and inventory management. By integrating YOLOv11-based detection systems in the process, farms and agribusinesses can improve efficiency, reduce labor costs, and enhance productivity.},
  keywords={Training;YOLO;Smart agriculture;Solid modeling;Accuracy;Quantization (signal);Transfer learning;Real-time systems;Yield estimation;Reliability;Fruit Detection;Transfer Learning;YOLO;Deep Learning;Computer Vision},
  doi={10.1109/eStream66938.2025.11016889},
  ISSN={2690-8506},
  month={April},}
@INPROCEEDINGS{11336473,
  author={Wang, Chuanyi and Yu, Yongzhuo and Yue, Weiwei and Chen, Yuanyuan},
  booktitle={2025 6th International Conference on Machine Learning and Computer Application (ICMLCA)}, 
  title={SCS-YOLO: A Lightweight Embedded DeepLearning Method for Tomato Fruit Maturity Detection Based on YOLOv11}, 
  year={2025},
  volume={},
  number={},
  pages={158-162},
  abstract={Traditional methods for assessing tomato fruit ripeness primarily rely on manual visual inspection, which is inefficient, highly subjective, and poorly adaptable to dynamic environmental conditions. To address these limitations, this study proposes a lightweight model named SCS-YOLO. Specifically, the YOLOv11 backbone network is redesigned by incorporating the ShuffleNetV2 module, which significantly reduces the number of parameters while enhancing feature extraction capabilities. Furthermore, a lightweight Cross-Scale Feature Fusion Module (CCFM) is introduced to facilitate effective fusion and recognition of multi-scale features. Lastly, the bounding box regression loss function is replaced with SIoU, which is more suitable for small object detection and contributes to improved accuracy. Experimental evaluations were conducted on a self-constructed dataset, comprising 13,649 images collected under two lighting conditions, two types of occlusion and three stages of ripeness. The results show that the improved SCS-YOLO model reduces computational complexity (GFLOPs) by 52.4% and parameter count by 64.0%. The model achieves a mean average precision (mAP) of 96.0%, with only a 0.6% drop compared to the baseline. In addition, the model size is reduced from 5.5MB to 2.2MB, representing a 60% reduction. These findings indicate that SCS-YOLO offers a compelling balance between accuracy and efficiency, making it particularly well suited for deployment on resource-constrained platforms such as edge computing devices.},
  keywords={YOLO;Visualization;Accuracy;Computational modeling;Manuals;Robustness;Real-time systems;Yield estimation;Computational complexity;Monitoring;tomato maturity detection;lightweight network;object detection;YOLO;edge AI},
  doi={10.1109/ICMLCA66850.2025.11336473},
  ISSN={},
  month={Oct},}
@INPROCEEDINGS{11347840,
  author={Jing, Hao and Fan, Ruilin and Hong, Longwu and Li, Zelun},
  booktitle={2025 IEEE International Conference on Sensing, Diagnostics, Prognostics, and Control}, 
  title={YOLO-ESS: Improved Citrus Recognition under Natural Orchard Conditions}, 
  year={2025},
  volume={},
  number={},
  pages={338-341},
  abstract={Citrus harvesting in natural orchards encounters significant challenges due to complex illumination, occlusion, and background interference. To overcome the limitations of current detection models in identifying small and occluded fruits, this study introduces YOLO-ESS, an enhanced lightweight detection framework specifically optimized for citrus recognition and localization. YOLO-ESS incorporates three innovative modules: (1) the C3k2-CGLU module, which enhances multi-scale feature extraction through a dual-branch convolution and a memory-gated mechanism; (2) the SCMB (Shuffle-Channel Upsample Block), which facilitates improved feature fusion and inter-channel communication; and (3) the SCBN Head, which stabilizes predictions by integrating shared convolutional kernels with independent batch normalization. Experimental results indicate that YOLO-ESS achieves an mAP@50 of 96.8%, an mAP@50:95 of 73.6%, and a processing speed of 243 FPS on the citrus dataset, surpassing existing YOLO and Faster R-CNN variants while maintaining low computational complexity. The model demonstrates robust performance under varying illumination and occlusion conditions, thereby providing a stable and efficient visual perception system for intelligent fruit-picking robots. This study illustrates that the YOLO-ESS framework presents a practical solution for real-time agricultural applications and establishes a foundation for future research in precision fruit harvesting and smart farming.},
  keywords={YOLO;Smart agriculture;Computational modeling;Lighting;Feature extraction;Robot sensing systems;Real-time systems;Stability analysis;Sensors;Visual perception;Citrus detection;Deep learning;Object recognition;Lightweight neural network},
  doi={10.1109/SDPC68151.2025.11347840},
  ISSN={},
  month={Nov},}
@INPROCEEDINGS{11009669,
  author={Qian, Jingxuan and Seong, Myeongsu},
  booktitle={2025 7th International Conference on Software Engineering and Computer Science (CSECS)}, 
  title={YOLO-ASFF: A Model for Detecting Tomatoes of Different Maturities Based on Improved YOLO v5s}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={In agricultural production, accurate detection of tomatoes of different maturities is crucial to control the picking time and improve grading efficiency. However, the orchard environment is complex, which brings many challenges to detecting tomatoes of different maturities, such as variable light conditions, lush branches and leaves, fruit occlusion, tomatoes with different sizes, etc. Traditional methods rely on manual experience, which is not only time-consuming but also has limited accuracy. To this end, the YOLO-ASFF model is proposed to improve the detection accuracy of tomatoes of different maturities in complex orchard environments in this work. On the one hand, the model uses the extended intersection over union (EIoU) to optimize the bounding box positioning to ensure that tomatoes of different sizes and maturities could be accurately framed. On the other hand, the adaptive spatial feature fusion (ASFF) module was integrated to enhance the fusion ability of multi-scale features, so that the model could capture feature information more comprehensively when detecting tomatoes with different maturities. The experimental results show that the YOLO-ASFF model performs better than other models, including Faster R-CNN, EfficientNet, YOLO v5s, and YOLO v11n, in detecting tomatoes of different maturities, with an accuracy of 0.885, a recall rate of 0.835, a mean average precision of 0.850, and an Fl-Score of 0.850. In short, YOLO-ASFF can provide an effective method for accurately identifying tomatoes with different maturities, which can help reduce labor costs and improve picking efficiency.},
  keywords={YOLO;Hands;Adaptation models;Accuracy;Costs;Production;Manuals;Feature extraction;Testing;Software engineering;different maturities;tomato;detection;YOLO-ASFF},
  doi={10.1109/CSECS64665.2025.11009669},
  ISSN={},
  month={March},}
@INPROCEEDINGS{10581681,
  author={Ling, Haiying and Tu, Zhirong and Li, Guo and Wang, Jijie},
  booktitle={2024 5th International Seminar on Artificial Intelligence, Networking and Information Technology (AINIT)}, 
  title={ED-YOLOv8s: An Enhanced Approach for Passion Fruit Maturity Detection Based on YOLOv8s}, 
  year={2024},
  volume={},
  number={},
  pages={2320-2324},
  abstract={Accurate assessment of the ripeness of passion fruits, which grow on trellises in orchards, is essential for efficient harvesting, grading, transportation, and storage processes, especially considering the potential occlusion and overlap among the fruits. This study introduces an enhanced maturity detection method, based on YOLOv8s. We first present the DyHead dynamic detection head, which significantly augments the expressive power of the target detection head without adding computational complexity. We then propose the EM_C-C2f lightweight module to optimize the backbone network of YOLOv8s. Experimental results from three custom datasets show considerable improvements achieved by the ED-YOLOv8s model across various evaluation metrics. Compared to other YOLO series object detection networks, ED-YOLOv8s demonstrates superior performance in terms of precision, recall, and mAP. Specifically, on the comprehensive passion fruit dataset, the model achieves a 2.6% increase in precision and a 1.3% increase in recall compared to the original YOLOv8s. Moreover, ED-YOLOv8s attains a mAP@50 score of 98.4%, reflecting a 1.3% improvement, and a mAP@50:95 score of 91.9%, marking a 0.6% improvement over the original YOLOv8s.},
  keywords={YOLO;Seminars;Measurement;Accuracy;Computational modeling;Transportation;Feature extraction;maturity detection;multi-scale;passion fruit;lightweight;YOLOv8s},
  doi={10.1109/AINIT61980.2024.10581681},
  ISSN={},
  month={March},}
@INPROCEEDINGS{11365044,
  author={Minh, Pham Quang and Tan, Lang Nhat and Tu, Ngo Hoang and Anh, Nguyen Thai},
  booktitle={2025 RIVF International Conference on Computing and Communication Technologies (RIVF)}, 
  title={Fruit Ripeness Detection: A Comparative Analysis of State-of-the-Art YOLO Models}, 
  year={2025},
  volume={},
  number={},
  pages={699-704},
  abstract={Accurate fruit ripeness detection is critical for reducing post-harvest losses and ensuring optimal quality control in the agricultural supply chain. This paper presents a comparative analysis of three state-of-the-art object detection architectures, YOLOv10, YOLOv11, and YOLOv12, applied to the task of multi-class fruit ripeness classification. A custom dataset of 22,128 images encompassing tomatoes, bananas, and mangoes was curated and relabeled into 11 distinct ripeness classes based on visual and physiological indicators linked to ethylene production. All models were trained under identical conditions using two input resolutions of $480 \times 480$ and $640 \times 640$ to ensure statistical fairness. Experimental results show that YOLOv12l consistently achieves the best accuracy, attaining an mAP50 of 94.39%, mAP50-95 of 82.17%, precision of 92.7%, and recall of 91.0%, albeit at the cost of higher latency. YOLOv10 and YOLOv11 exhibit superior inference speeds, making them more suitable for real-time and edge-based applications. The confusion matrix and qualitative visualizations confirm YOLOv12l's robustness under challenging conditions such as occlusion, color camouflage, and reflective surfaces. The study concludes with a discussion of practical deployment challenges and outlines open research directions toward scalable, real-world smart farming systems.},
  keywords={YOLO;Smart agriculture;Visualization;Accuracy;Supply chains;Quality control;Production;Robustness;Real-time systems;Physiology;Computer vision;fruit ripeness detection;YOLO family;object detection;post-harvest loss;non-destructive analysis;deep learning},
  doi={10.1109/RIVF68649.2025.11365044},
  ISSN={2473-0130},
  month={Dec},}
@INPROCEEDINGS{10862633,
  author={Uriti, Archana and Pothabathula, Naga Jyothi},
  booktitle={2024 International Conference on Intelligent Computing and Sustainable Innovations in Technology (IC-SIT)}, 
  title={Evaluating Object Detection Approaches for Fruit Detection in Precision Agriculture: A Comprehensive Review}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Agricultural automation has become increasingly vital in addressing the growing demand for food and the need for efficient farming practices. Fruit harvesting is crucial in agriculture due to its labor intensity and the challenges of timely, accurate picking under occlusions and varying illumination. Various methods have been developed for accurate fruit detection, but traditional techniques often struggle with occlusions by branches or leaves, as well as challenges posed by climate and fruit maturity. This study reviews existing literature, compares various fruit detection approaches and discusses their strengths and weaknesses. Building on the work of various authors, this paper aims to offer a thorough understanding of the current state of fruit detection technologies in agricultural automation. Additionally, the survey addresses the objective of the proposed work, which is to identify the most promising techniques for improving fruit detection accuracy and efficiency.},
  keywords={YOLO;Surveys;Technological innovation;Automation;Accuracy;Reviews;Redundancy;Lighting;Real-time systems;Reliability;Agricultural automation;fruit harvesting;Occlusion;Illumination variation;Maturity},
  doi={10.1109/IC-SIT63503.2024.10862633},
  ISSN={},
  month={Nov},}
@INPROCEEDINGS{10985647,
  author={Goradia, Neil},
  booktitle={2025 IEEE International Conference on Interdisciplinary Approaches in Technology and Management for Social Innovation (IATMSI)}, 
  title={RGB-D Detection and Localization for Agricultural Robotics in Low-Resource Settings}, 
  year={2025},
  volume={3},
  number={},
  pages={1-6},
  abstract={Agriculture in low-resource settings faces challenges such as limited access to electricity, low profits, variability in environmental conditions, and high costs. Machine learning (ML) offers solutions to these issues, particularly in tasks like automated fruit picking. This paper focuses on the detection and 3D localization of apples using YOLOv5n and YOLOv10n models, which are lightweight variants suitable for deployment in resource-constrained environments. We provide in-depth details about our fruit dataset and annotation protocols to elucidate the diversity and scalability of our approach. Further, we conduct a broader comparison with other state-of-the-art models to substantiate our claims of superior performance. Our experiments, conducted with an Intel RealSense camera, include detailed depth perception analysis under various conditions, revealing that YOLOv10n outperforms YOLOv5n in both detection accuracy and 3D localization precision. We also address potential deployment challenges such as hardware costs, environmental variability, and energy efficiency, and discuss limitations to guide future research. Our results suggest that YOLOv10n offers a highly effective solution for real-time, reliable fruit detection in low-resource agricultural settings. Our code is available here.},
  keywords={Location awareness;YOLO;Costs;Three-dimensional displays;Annotations;Real-time systems;Hardware;Energy efficiency;Agriculture;Robots;Agricultural robotics;YOLO;low-resource settings;fruit detection;depth perception;real-time localization},
  doi={10.1109/IATMSI64286.2025.10985647},
  ISSN={},
  month={March},}
@INPROCEEDINGS{11331612,
  author={Cao, Yihao and Lu, Xuming},
  booktitle={2025 5th International Conference on Electronic Information Engineering and Computer Technology (EIECT)}, 
  title={PLD-YOLO: A Lightweight Nectarine Recognition Model in Complex Environments}, 
  year={2025},
  volume={},
  number={},
  pages={84-89},
  abstract={To achieve automated harvesting in nectarine orchards and address the challenges of nectarine detection under complex environments—including fruit occlusion, leaf occlusion, variations in illumination, and changes in fruit size—this paper proposes a lightweight nectarine fruit recognition model based on an improved YOLOv8n, named PLD-YOLO (Peach Lightweight Detection based on You Only Look Once). First, by combining Partial Convolution (PConv) with the Convolutional Block Attention Module (CBAM), a Lightweight Feature Extraction (LFE) module is designed to improve the recognition accuracy of nectarines occluded by leaves and fruits, while meeting the deployment requirements of edge devices. Second, by integrating the advantages of Ghost Convolution (GhostConv) and Dynamic Convolution (DynamicConv), a Lightweight Dynamic Convolution (LDConv) module is developed to replace the Bottleneck in C2f, forming the C2f-LDConv module, which reduces model parameters and enhances nectarine localization accuracy. Finally, a Lightweight Shared Convolutional Detection Head (LSCD) is proposed to capture multi-scale feature information and further improve detection performance. Experimental results show that PLD-YOLO achieves excellent performance in nectarine detection under natural scenes, with a 0.8 % increase in recall, a 0.3 % increase in mAP50, a 56 % reduction in model parameters, and a 53 % reduction in computational cost. This model not only satisfies the requirements for lightweight deployment but also provides essential support for future application in intelligent harvesting equipment.},
  keywords={YOLO;Location awareness;Accuracy;Convolution;Computational modeling;Redundancy;Lighting;Feature extraction;Real-time systems;Computational efficiency;YOLO;peach;object detection},
  doi={10.1109/EIECT68017.2025.11331612},
  ISSN={},
  month={Oct},}
@ARTICLE{10753036,
  author={Ji, Baofeng and Zhao, Jingming and Tao, Fazhan and Zhang, Ji and Zhang, Gaoyuan and Wang, Nan and Zhang, Ping and Fan, Huitao},
  journal={IEEE Transactions on AgriFood Electronics}, 
  title={A Novel Nectarine Fruit Maturity Detection and Classification Counting Model Based on YOLOv8n}, 
  year={2025},
  volume={3},
  number={1},
  pages={144-155},
  abstract={Fruit yield assessment is an important aspect of orchard management. In this context, target detection of fruit is of paramount importance. However, due to complex factors in real orchard environments, such as fruit occlusion, insufficient lighting, and overlapping fruits, traditional detection and counting methods often suffer from low detection accuracy and inadequate classification precision, failing to meet the requirements of practical applications. To address this issue, we focus on nectarine fruit and propose an improved YOLOv8n-based object detection algorithm model, YOLOv8n-global feature extraction enhancement (GFE). We integrate the effective squeeze-and-excitation attention mechanism into the YOLOv8n model. This integration allows our approach to adaptively adjust the weight of each channel, which enhances both detection efficiency and target recognition accuracy. Then, we introduce focal distance-intersection over union loss to address the misjudgment of hard samples. This further contributes to improving detection accuracy. In addition, we incorporate the gather-and-distribute mechanism from GOLD-YOLO, replacing the traditional feature pyramid network structure. This enhancement improves the information fusion capability in the neck of the model, leading to a higher mean average precision (mAP@0.5). In addition, the output of the improved model can be used as an input to DEEPSORT to classify and count nectarine fruit. This functionality can be used for estimating fruit maturity and yield in orchards. Experimental results demonstrate that the YOLOv8n-GFE model achieves a mAP@0.5 of 92.5%, which is an improvement of 3.2% over the original YOLOv8n model, meeting the required accuracy for recognizing nectarine fruit maturity in practical applications.},
  keywords={YOLO;Lighting;Feature extraction;Attention mechanisms;Shape;Detection algorithms;Data models;Image classification;Attention mechanism;classify and count;GOLD-YOLO;nectarine fruit;target detection;YOLOv8n},
  doi={10.1109/TAFE.2024.3488747},
  ISSN={2771-9529},
  month={March},}
@INPROCEEDINGS{10839762,
  author={Lu, Jiahuan and Lin, Xiangye and Li, Chenglin and Zeng, Shan and Luo, Xiwen and Li, Jiehao},
  booktitle={2024 IEEE International Conference on Unmanned Systems (ICUS)}, 
  title={Methods for Mango and Ripeness Detection Using Improved YOLOv8}, 
  year={2024},
  volume={},
  number={},
  pages={1569-1573},
  abstract={Automated mango harvesting is a trending practice, yet recognizing mangoes and their ripeness remains a bottleneck due to uneven lighting, fruit overlap, and the similar colors of fruit and leaves. To address these challenges, this paper proposes a method for mango and ripeness detection based on an improved You Only Look Once version 8 (YOLOv8). This method incorporates attention mechanisms and lightweight enhancements to achieve accurate and rapid detection of mangoes and their ripeness under varying lighting conditions, different levels of occlusion, and backgrounds where the colors of fruits and leaves are similar. Validation on 2,742 samples demonstrates that the proposed method based on improved YOLOv8 achieves a mean Average Precision (mAP) of 96.6%, processing each sample in just 22.07 ms. Compared to YOLOv8, the proposed method improves mAP by 1.8% while reducing processing speed by 8.6%. This method provides a precise and rapid detection technology for the automated harvesting of mangoes and potentially other fruits.},
  keywords={YOLO;Adaptation models;Attention mechanisms;Autonomous systems;Computational modeling;Lighting;Color;Real-time systems;Classification algorithms;Load modeling;fruit detection;ripeness detection;deep learning;attention mechanism;YOLOv8},
  doi={10.1109/ICUS61736.2024.10839762},
  ISSN={2771-7372},
  month={Oct},}
@ARTICLE{10505191,
  author={Xiao, Xu and Jiang, Yiming and Wang, Yaonan},
  journal={IEEE Instrumentation & Measurement Magazine}, 
  title={A Method of Robot Picking Citrus Based on 3D Detection}, 
  year={2024},
  volume={27},
  number={3},
  pages={50-58},
  abstract={It is important to monitor the maturity of citrus fruits during the growth period by using deep learning to implement visual detection technology to identify their state of ripeness in their natural environment. The problem is that the ripeness of citrus fruits is mainly judged manually, and there is a lack of fast and accurate automatic detection methods for citrus fruit ripeness. In this study, the optimal weight model was trained from 1688 images of citrus fruits collected in the natural environment based on the lightweight YOLOv4-Tiny model. The experimental results show that the model has 92.4% mAP for citrus fruit detection, and the detection accuracy of Faster R-CNN is slightly higher than that of the improved YOLOv4 Tiny compared with the current mainstream two-stage detection algorithm Faster R-CNN. Although the improved YOLOv4 Tiny has better detection speed, compared with the harvesting performance of the harvesting robot, the improved YOLOv4 Tiny is better. YOLOv5 and YOLOv4 are generally weaker than the improved YOLOv4-Tiny, and the model has more parameters and occupies more memory. Meanwhile, the model can achieve accurate recognition of fruits under different shooting distances, different shading situations and different lighting situations, and can quickly and effectively identify the ripeness of citrus fruits under complex backgrounds with strong robustness. The system can provide technical support for yield estimation of citrus fruit orchards and the location detection of picking machines and has reference value for recognition and ripeness detection of other fruits.},
  keywords={YOLO;Performance evaluation;Visualization;Three-dimensional displays;Lighting;Robustness;Agricultural products;Crops;Deep learning;Detection algorithms},
  doi={10.1109/MIM.2024.10505191},
  ISSN={1941-0123},
  month={May},}
@ARTICLE{10559970,
  author={Gai, Rongli and Liu, Yong and Xu, Guohui},
  journal={IEEE Access}, 
  title={TL-YOLOv8: A Blueberry Fruit Detection Algorithm Based on Improved YOLOv8 and Transfer Learning}, 
  year={2024},
  volume={12},
  number={},
  pages={86378-86390},
  abstract={Blueberry fruit in the picking process are characterized by small fruit particles, similar color characteristics of immature fruits to leaf, and not obvious characteristics of fruits obscured by leaves, which lead to low real-time detection accuracy of blueberry fruits and fail to meet the detection standard of automatic picking. To improve the detection accuracy, we propose a blueberry identification algorithm named TL-YOLOv8 based on the YOLOv8 algorithm. By introducing an improved MPCA (Multiplexed Coordinated Attention) in the last layer of the backbone network, we enhance the feature extraction capability during the training process. By replacing the C2f module with an OREPA(Online Convolutional Re-parameterization) module, not only the training is accelerated, but also the characterization is enhanced. Meanwhile, in order to cope with the fruit occlusion problem more effectively, we introduce the MultiSEAM (Multi-scale Separation and Occlusion-Aware Module). As a means of optimizing the model parameters, we pre-trained the model using Transfer Learning to improve the generalization ability of the network. The method achieved 84.6% Precision, 91.3% recall and 94.1% mAP on the blueberry dataset, where mAP was improved by 3.4% over the original algorithm, and the experiments showed that it can be effective for blueberry fruit detection.},
  keywords={Training;Feature extraction;Task analysis;Convolutional neural networks;Transfer learning;YOLO;Accuracy;Deep learning;Blueberry detection;deep learning;object detection;occlusion;transfer learning;YOLOv8},
  doi={10.1109/ACCESS.2024.3416332},
  ISSN={2169-3536},
  month={},}
@INPROCEEDINGS{10152740,
  author={Li, Yuqi and Gong, Zirui and Zhou, Yihang and He, Yuting and Huang, Renjie},
  booktitle={2023 26th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={Production Evaluation of Citrus Fruits based on the YOLOv5 compressed by Knowledge Distillation}, 
  year={2023},
  volume={},
  number={},
  pages={1938-1943},
  abstract={Pre-harvest estimation of fruit production is crucial for fruit storage and price analysis in the planting of fruit trees. However, prior research consistently displays low accuracy because of problems with small objects, leaf occlusion, and fruit overlap, and they emphasize large networks that are unrealistic in the real world. In this study, we emphasize the use of smartphones to evaluate citrus fruit production. We suggest a simple method for detecting objections based on the YOLOv5 algorithm compressed by knowledge distillation. To extract the visual features, we first use mobilenetV2 as the foundation of YOLOv5. To learn the reliable detection features, we also incorporate an attention mechanism into YOLOv5. As such, we can obtain embedded Yolo served as a student model, which is learned via knowledge distillation. As such we can take the lightweight student model as the final detection model. Finally, we take the embedded Yolo to detect the citrus fruits and take a linear regression model to predict the number of counted fruits and the production is estimated. Experiments show that the proposed method can accurately count fruits and approximate the production.},
  keywords={Knowledge engineering;Visualization;Federated learning;Linear regression;Estimation;Production;Predictive models;YOLOv5;knowledge distillation;citrus fruits;object detection;linear regression},
  doi={10.1109/CSCWD57460.2023.10152740},
  ISSN={2768-1904},
  month={May},}
@INPROCEEDINGS{10762508,
  author={Chen, Yiran and Yao, Rui and Liu, Haoran and Liu, Bingqi and Liu, Mingzhe},
  booktitle={2024 5th International Conference on Big Data & Artificial Intelligence & Software Engineering (ICBASE)}, 
  title={Automatic Fruit Detection Based on Robotic Vision}, 
  year={2024},
  volume={},
  number={},
  pages={761-765},
  abstract={Automatic fruit detection has greatly reduced labor costs and crop damage rates, contributing to the progress of agricultural modernization. It involves real-time assessment of the surrounding environment and recognition of target fruit categories. However, fruit detection faces challenges due to the similarities in shape, color, and other features among different types of fruits, as well as the impact of environmental factors such as inadequate lighting, occlusion, and background variations on recognition accuracy. This project focuses on the simulation of the robotic fruit harvesting process, which includes environmental image acquisition, image processing, and robot control. The robot utilizes its integrated camera to capture real-time images of the surrounding environment. These images are then processed on a computer, employing color recognition based on traditional algorithms. The images are segmented based on the identified color regions and subjected to object detection using YOLO v5. By discerning the presence of the target objects, the results are transmitted to the robot, which responds accordingly. The real-time performance is enhanced by filtering and narrowing down the target regions, reducing the time required for object recognition.},
  keywords={YOLO;Image recognition;Accuracy;Image color analysis;Target recognition;Lighting;Laser feedback;Real-time systems;Computational efficiency;Laser beams;Object Detection;Robot Control;Deep Learning},
  doi={10.1109/ICBASE63199.2024.10762508},
  ISSN={},
  month={Sep.},}
@INPROCEEDINGS{11158649,
  author={Tandel, Karan and Vaidya, Rachit and Thakkar, Hiren Kumar},
  booktitle={2025 International Conference on Advancements in Smart, Secure and Intelligent Computing (ASSIC)}, 
  title={On the Design of Multiple Fruits Recognition Model Using Deep Learning in a Confined Environment}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The real world application of fruit detection in an confined environment comes with multiple challenges such as occlusion, lighting variation, and background noise. Deep Learning owing to its capability of obtaining robust features from the images has been of enormous usage in every domain of today's fast growing world. Thus the main purpose of this research paper is to come up with a model using pre-trained model like YOLOv8 to give a fully functional model of fruit detection and classification in a real world environment which will be able to handle the unnecessary background noises and will be focusing on generalizing across multiple fruit types. The application of such models can be used in areas like Automated Harvesting [1], Supply Chain Management, Quality Control and Food Waste Management as well [2].},
  keywords={Deep learning;YOLO;Training;Systematics;Supply chain management;Lighting;Quality control;Robustness;Convolutional neural networks;Background noise;You Only Look Once (YOLO);Deep Learning;Convolutional Neural Network (CNN)},
  doi={10.1109/ASSIC64892.2025.11158649},
  ISSN={},
  month={May},}
@INPROCEEDINGS{10956721,
  author={Kiran, J. Sasi and V, Dilli Ganesh and Singh, Navdeep and Abbas, Haider Mohammed and Saravanan, R. and K, Aanandha Saravanan},
  booktitle={2025 International Conference on Automation and Computation (AUTOCOM)}, 
  title={Automated Fruit Counting with YOLOv5 Model for Harvest Management in Orchards}, 
  year={2025},
  volume={},
  number={},
  pages={235-240},
  abstract={Proper counting of fruits on trees is vital for proper timing & scheduling of harvesting, labor force requirement and making agricultural sector more efficient. Manual methods are costly and time-consuming together with being inaccurate in most if not all aspects hence the need for automation. It also demonstrates how real-time fruit detection and counting can be performed using YOLOv5 with potential in handling orchards in a more efficient manner. YOLOv5 was trained on a dataset of fruits in different settings including clear sun lit conditions, in overcast conditions, and in conditions where fruits are entangled in large vegetation. The proposed model was able to release the highest detection accuracy with higher precision, recall, and F1 scores; 97.5%, 96.1%, respectively and 96.8% for the F1-score. It also attained a mean Average Precision (mAP@0.5) of 98.2%, and further validating its endurance in fruit detection regardless of scenarios. Due to the YOLOv5's real-time indexing that provides about 30 FPS on edge devices, that makes it ideal to be used on drones and mobile autonomous vehicles in large-scale orchards. A comparison with other object detection models like Faster R-CNN, SSD, and Mask R-CNN, proved that YOLOv5 performs better in accuracy as well as in time efficiency. However, there was a small decline in the detection accuracy in cases of partial fruit occlusion or dense foliage. In conclusion, this particular work demonstrates that indeed YOLOv5 can easily solve the problem of automated fruit counting and bring multiple enhancements to the orchard management and precision agriculture.},
  keywords={YOLO;Performance evaluation;Accuracy;Automation;Image edge detection;Vegetation mapping;Vegetation;Real-time systems;Timing;Synthetic data;YOLOv5;automated fruit counting;orchard management;real-time detection},
  doi={10.1109/AUTOCOM64127.2025.10956721},
  ISSN={},
  month={March},}
@INPROCEEDINGS{10424305,
  author={Cardellicchio, Angelo and Renò, Vito and Devanna, Rosa Pia and Marani, Roberto and Milella, Annalisa},
  booktitle={2023 IEEE International Workshop on Metrology for Agriculture and Forestry (MetroAgriFor)}, 
  title={Tomato detection in challenging scenarios using YOLO-based single stage detectors}, 
  year={2023},
  volume={},
  number={},
  pages={54-59},
  abstract={Fruit detection is a fundamental task for several agricultural applications, including robotic harvesting, yield estimation, and precision farming in general. However, uneven field conditions, such as branch and leaf occlusions, lighting variations, and shading, make this task particularly challenging. This paper proposes a deep learning approach to automatically segment tomato berries, using transfer learning from two state-of-the-art deep neural networks, namely YOLOv5 and YOLOv8, previously trained on images acquired under controlled conditions. The results obtained for images captured under various field conditions by a consumer-grade camera demonstrate that the models achieve relatively high classifying performance despite the low quality of the input images and the challenges arising from reduced object size, similarity between objects, and their color, fruit cluster occlusions, and highly variable illumination conditions.},
  keywords={YOLO;Transfer learning;Lighting;Detectors;Data models;Yield estimation;Task analysis},
  doi={10.1109/MetroAgriFor58484.2023.10424305},
  ISSN={},
  month={Nov},}
@INPROCEEDINGS{11103361,
  author={Li, Wenqin and Sui, Tingting and Zhang, Zhang and Wu, Huiying and Chang, Liang},
  booktitle={2025 6th International Conference on Computer Engineering and Application (ICCEA)}, 
  title={LEBR-YOLO: Accurate Fruit and Vegetable Detection Method for Space Station Cargo Bay}, 
  year={2025},
  volume={},
  number={},
  pages={01-07},
  abstract={In order to address the issue of detection accuracy, which is compromised by hand occlusion when astronauts retrieve items from the space station cargo bay, a modified algorithm has been developed. This algorithm, termed “YOLO11,” is designed to enhance the detection of fruits and vegetables in the cargo bay environment. LEBR-YOLO. The method enhances the initial convolution to a lightweight structure, thereby reducing the computational effort while expanding the receptive field. Additionally, a two-layer attention mechanism is incorporated to enhance the ability to extract features. The introduction of an enhanced lightweight shared deformable detection module has been demonstrated to enhance the detection capability in the presence of occlusion. Experimental results demonstrate that the proposed method attains 94.3 % accuracy, 88.5 % recall, and 93.3% mAP50 on the proprietary fruit and vegetable dataset, while preserving low model complexity to satisfy the requirements of the Lightship cargo spacecraft in orbit. The proposed method has been shown to be effective in the detection of fruit and vegetable items in the space station, enhancing detection accuracy and reducing false detections and omissions.},
  keywords={Space vehicles;Accuracy;Attention mechanisms;Convolution;Biological system modeling;Feature extraction;Routing;Robustness;Resource management;Space stations;Cargo hold fruit and vegetable detection;YOLO11;feature extraction;shared convolution},
  doi={10.1109/ICCEA65460.2025.11103361},
  ISSN={2159-1288},
  month={April},}
@INPROCEEDINGS{10774304,
  author={Yang, Xiaoyao and Zhao, Wenyang and Li, Yanqiang},
  booktitle={2024 IEEE 22nd International Conference on Industrial Informatics (INDIN)}, 
  title={A Multi-Feature Fusion Detection Network Based on an Orchard Complex Environment}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={In current smart picking devices, accurate target recognition is a prerequisite for improving picking efficiency and has great potential in the smart picking industry. However, the complex orchard environment leads to problems such as occlusion and light influence on the fruits, which causes some difficulties in feature extraction for detection models. This paper proposes an improved network, YOLO-RD, based on YOLOv5 and RepNC-SPELAN structure and Dynamic Head, which aims to improve the accuracy of fruit recognition in complex environments. The effect of the shape and angle of the bounding box itself is also taken into account and the Shape-iou loss function is used to further improve the accuracy of the regression. Additionally, it employs a dynamic detection head to unify the scale, spatial and task perceptions, and dynamically selects and adjusts different object detection heads to adapt to different tasks and scenes. The network is capable of performing real-time detection of fruits in complex orchard environments, thereby providing a robust foundation for the advancement of the smart picking industry.},
  keywords={Feature extraction;Head;Shape;Accuracy;YOLO;Neck;Solid modeling;Computational modeling;Complexity theory;Biological system modeling;YOLOv5;YOLO-RD;Target recognition},
  doi={10.1109/INDIN58382.2024.10774304},
  ISSN={2378-363X},
  month={Aug},}
@INPROCEEDINGS{11100674,
  author={Rosada, Rifki and Hussein, Zidane Muhammad and Novamizanti, Ledya},
  booktitle={2025 IEEE International Conference on Industry 4.0, Artificial Intelligence, and Communications Technology (IAICT)}, 
  title={Evaluating YOLO Variants for Real-Time Multi-Object Detection of Strawberry Quality and Ripeness}, 
  year={2025},
  volume={},
  number={},
  pages={483-490},
  abstract={Automated fruit grading plays a pivotal role in modern agriculture by enabling timely harvesting and maintaining quality standards, especially for high-value crops such as strawberries. This paper presents an end-to-end approach for the real-time detection and classification of strawberry ripeness using state-of-the-art YOLO-based models: YOLOv7, YOLOv8, and YOLOv11. A comprehensive dataset of 3,055 strawberry images is compiled from three distinct sources. Each image is meticulously annotated into five classes—Unripe (UNR), Fully Ripe Grade A (AFR), Fully Ripe Grade B (BFR), Half Ripe Grade A (AHR), and Half Ripe Grade B (BHR)—with additional complexity introduced by images containing multiple strawberries per frame. Data preprocessing and augmentation are performed using Roboflow, and model training is executed on Google Colab with a uniform protocol to ensure a fair comparison among the YOLO variants. Experimental results reveal a steady performance improvement from YOLOv7 to YOLOv11, with YOLOv11 achieving the highest detection accuracy (precision: 0.874, recall: 0.855, mAP@50: 0.942, and mAP@50–95: 0.820). The superior performance of YOLOv11 is attributed to its incorporation of dynamic attention modules and self-adaptive layer-wise fusion, which significantly enhance the detection of subtle ripeness variations and mitigate occlusion challenges. These findings underscore the potential of advanced YOLO architectures for deployment in real-time agricultural applications and automated harvesting systems.},
  keywords={YOLO;Training;Adaptation models;Sensitivity;Quantization (signal);Quality control;Real-time systems;Data models;Robustness;Standards;Strawberry;real-time detection;computer vision;YOLO;object detection;deep learning},
  doi={10.1109/IAICT65714.2025.11100674},
  ISSN={2834-8249},
  month={July},}
@INPROCEEDINGS{10348779,
  author={Melnychenko, Oleksandr and Savenko, Oleg and Radiuk, Pavlo},
  booktitle={2023 IEEE 12th International Conference on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications (IDAACS)}, 
  title={Apple Detection with Occlusions Using Modified YOLOv5-v1}, 
  year={2023},
  volume={1},
  number={},
  pages={107-112},
  abstract={In our research, we created a novel YOLOv5-v1 architecture to identify apples in images with occlusions. We specifically engineered new layers for the BottleneckCSP-v4 module, which replaces the original BottleneckCSP module within the backbone structure of the YOLOv5 network. Integrating the SENet module into our improved trunk network helps to discern features of medium and large-sized fruits more accurately under varying conditions. We also adjusted the initial size of the binding block within the source network to avoid incorrect identification of small objects within the image's background. Based on the test dataset, our experimental results show that our advanced network model can effectively identify fruits captured through an unmanned aerial vehicle camera. The classification metrics - recall, precision, mAP, and F1-score - obtained scores of 92.13%, 84.59%, 87.94%, and 89.02% respectively.},
  keywords={YOLO;Measurement;Image recognition;Data acquisition;Cameras;Autonomous aerial vehicles;Data models;image processing;object detection;apple yield;YOLOv5;deep learning;visual occlusions},
  doi={10.1109/IDAACS58523.2023.10348779},
  ISSN={2770-4254},
  month={Sep.},}
@INPROCEEDINGS{10691401,
  author={Qin, Lijuan and Wang, Xiaohan and Zhu, Yubin and Wang, Ting},
  booktitle={2024 2nd International Conference on Signal Processing and Intelligent Computing (SPIC)}, 
  title={Research on Fruit Picking Positioning Based on Binocular Vision}, 
  year={2024},
  volume={},
  number={},
  pages={750-754},
  abstract={Based on YOLOv5 object detection algorithm, fruit images are extracted from complex backgrounds in response to occlusion of branches and leaves, fruit overlap, and light effects caused by environment. Method of adding center coordinate value of image based on prediction box of fruit image determines centroid coordinate of target image. Then, by optimizing the focus camera and using Zhang Youzheng's calibration method, the image is calibrated using Matlab calibration box. Obtained image is stereo corrected using local stereo matching algorithm to obtain three-dimensional coordinates of centroid of target fruit, which are then converted into physical coordinates for positioning, After actual measurement, a positioning result with an error of ± 20mm was obtained, confirming its applicability for practical positioning operations.},
  keywords={YOLO;Visualization;Signal processing algorithms;Visual systems;Signal processing;Cameras;Prediction algorithms;Calibration;Standards;Matlab;apple picking;stereo matching algorithm;location},
  doi={10.1109/SPIC62469.2024.10691401},
  ISSN={},
  month={Sep.},}
@INPROCEEDINGS{11141306,
  author={Khazmi, Khalil and Lachiri, Zied},
  booktitle={2025 International Conference on Emerging Technologies and Computing (IC_ETC)}, 
  title={A Deep Dive Assessment into Recent YOLO Models Efficiency and Robustness for Agricultural Dense Scene Analysis: A Wheat Head Study Case}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Applications of artificial intelligence (AI) in agriculture are becoming more and more omnipresent. When applied to detecting problems in dense scene analysis in agricultural challenges, they offer answers to issues that previous metaheuristics were unable to address with a degree of accuracy that permits the industrialization of the suggested solutions. Therefore, counting wheat heads in field conditions with spike and spikelet occlusions and overlaps is one of the most difficult looked into and explored challenges in computer vision for agriculture in the post-pandemic period of awareness regarding staple crop security. In order to enable farmers, breeders, and agronomists to monitor the emergence and growth of wheat heads over time and space, as well as to extrapolate yield estimations, the ultimate goal is to provide a reliable and essential informational input among many other essentials. This paper proposes implementing YOLOv10, YOLOv11 and YOLOv12 models to GHWD, a global wheat head dataset compiled from various continents to ensure phenotype diversity, in order to address mentioned issues using new deep learning advancements. We then test the robustness of the obtained results on a self-compiled Tunisian wheat dataset. Finally, we compare and discuss the results.},
  keywords={YOLO;Deep learning;Computer vision;Image analysis;Phenotypes;Agriculture;Robustness;Yield estimation;Security;Artificial intelligence;wheat head;deep learning;YOLO;agriculture;dense scene;yield estimation;computer vision},
  doi={10.1109/IC_ETC65981.2025.11141306},
  ISSN={},
  month={June},}
@INPROCEEDINGS{10912853,
  author={Wu, Jiaming and Ge, Yuxuan and Wu, Jianxiong and Cao, Jin and Feng, Junhao},
  booktitle={2024 6th International Conference on Frontier Technologies of Information and Computer (ICFTIC)}, 
  title={Design and Implementation of Intelligent Orchard Robot}, 
  year={2024},
  volume={},
  number={},
  pages={1555-1560},
  abstract={This paper addresses the labor shortages and high costs in traditional agriculture by designing an intelligent orchard picking robot. The robot leverages the ROS operating system, NVIDIA Jetson Nano, and a tracked chassis to navigate complex terrains. Key technologies include SLAM for real-time mapping, A* for path planning, and YOLOv5 for fruit detection. Experiments conducted in a simulated orchard environment demonstrate the robot's effectiveness in autonomous navigation and accurate fruit recognition, achieving 95% recognition accuracy in clear conditions and 75% under occlusion. The results showcase the robot's potential to significantly enhance productivity and reduce labor demands in orchard harvesting.},
  keywords={YOLO;Smart agriculture;Productivity;Simultaneous localization and mapping;Accuracy;Navigation;Operating systems;Real-time systems;Path planning;Robots;Smart Agriculture;Orchard Picking;SLAM;A*;YOLOv5},
