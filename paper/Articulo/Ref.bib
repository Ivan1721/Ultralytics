@INPROCEEDINGS{10972542,
  author={Bengtson, Stefan Hein and Lehotský, Daniel and Ismiroglou, Vasiliki and Madsen, Niels and Moeslund, Thomas B. and Pedersen, Malte},
  booktitle={2025 IEEE/CVF Winter Conference on Applications of Computer Vision Workshops (WACVW)}, 
  title={AutoFish: Dataset and Benchmark for Fine-Grained Analysis of Fish}, 
  year={2025},
  volume={},
  number={},
  pages={1513-1522},
  abstract={Automated fish documentation processes are in the near future expected to play an essential role in sustainable fisheries management and for addressing challenges of overfishing. In this paper, we present a novel and publicly available dataset named AutoFish designed for fine-grained fish analysis. The dataset comprises 1,500 images of 454 specimens of visually similar fish placed in various constellations on a white conveyor belt and annotated with instance segmentation masks, IDs, and length measurements. The data was collected in a controlled environment using an RGB camera. The annotation procedure involved manual point annotations, initial segmentation masks proposed by the Segment Anything Model (SAM), and subsequent manual correction of the masks. We establish baseline instance segmentation results using two variations of the Mask2Former architecture, with the best performing model reaching an mAP of 89.15%. Additionally, we present two baseline length estimation methods, the best performing being a custom MobileNetV2-based regression model reaching an MAE of 0.62cm in images with no occlusion and 1.38cm in images with occlusion. Link to project page: https://vap.aau.dk/autofish/},
  keywords={Instance segmentation;Computer vision;Annotations;Conferences;Estimation;Manuals;Documentation;Computer architecture;Length measurement;Fisheries},
  doi={10.1109/WACVW65960.2025.00174},
  ISSN={2690-621X},
  month={Feb},}@INPROCEEDINGS{10350532,
  author={Sun, Fengyuan and Karaoglu, Sezer and Gevers, Theo},
  booktitle={2023 IEEE/CVF International Conference on Computer Vision Workshops (ICCVW)}, 
  title={Temporally Consistent Semantic Segmentation using Spatially Aware Multi-view Semantic Fusion for Indoor RGB-D videos}, 
  year={2023},
  volume={},
  number={},
  pages={4250-4259},
  abstract={The task of performing image semantic segmentation faces challenges in achieving consistent and robust results across a sequence of video frames. This problem becomes more prominent for indoor scenes where small camera movement can lead to drastic appearance changes, occlusions, and loss of global context information.To overcome these challenges, this paper proposes a novel approach that combines multi-view semantic fusion with spatial reasoning to produce view-invariant semantic features for temporally consistent semantic segmentation for indoor RGB-D videos.The experiments are conducted on the ScanNet dataset, showing that the proposed spatially aware multi-view fusion mechanism significantly improves the state-of-the-art image semantic segmentation methods Mask2Former and ViT-Adapter. In particular, the proposed pipeline offers improvements of 5%, 9.9%, and 14.4% in 2D mIoU, cross-view consistency, and temporal consistency, respectively, when compared to Mask2Former. Similarly, when compared to ViT-Adapter, the proposed mechanism offers enhancements of 4.8%, 8.9%, and 10.9% in the same metrics.},
  keywords={Measurement;Computer vision;Semantic segmentation;Conferences;Semantics;Pipelines;Cameras},
  doi={10.1109/ICCVW60793.2023.00459},
  ISSN={2473-9944},
  month={Oct},}@INPROCEEDINGS{10491166,
  author={Ebrahimzadeh, Mohammad and Manzuri, Mohammad Taghi},
  booktitle={2024 13th Iranian/3rd International Machine Vision and Image Processing Conference (MVIP)}, 
  title={MaskChanger: A Transformer-Based Model Tailoring Change Detection with Mask Classification}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Change detection in multi-temporal remote sensing data enables crucial urban analysis and environmental monitoring applications. However, complex factors like illumination variance and occlusion make robust automated change interpretation challenging. We propose MaskChanger - a novel deep learning paradigm tailored for satellite image change detection. Our method adapts the segmentation-specialized Mask2Former architecture by incorporating Siamese networks to extract features separately from bi-temporal images, while retaining the original mask transformer decoder. To our knowledge, this is the first study in which change detection is converted from the existing per-pixel classification approach into a mask classification approach. Evaluated on the LEVIR-CD benchmark of over 600 very high-resolution image pairs exhibiting real-world rural and urban changes, MaskChanger achieves Fl-Score of 91.96%, outperforming prior transformer-based change detection approaches.},
  keywords={Representation learning;Image segmentation;Object segmentation;Transformers;Feature extraction;Decoding;Sensors;Change Detection;Remote Sensing Image;Transformer},
  doi={10.1109/MVIP62238.2024.10491166},
  ISSN={2166-6784},
  month={March},}@INPROCEEDINGS{11407412,
  author={Shu, Zixuan and Wang, Junxiang and Xu, Xi and Wang, HongFei and Li, Ye},
  booktitle={2025 2nd International Conference on Image Processing, Multimedia Technology and Machine Learning (IPMML)}, 
  title={Dynamic Refinement-Based Video Object Segmentation for Mouse Videos}, 
  year={2025},
  volume={},
  number={},
  pages={129-133},
  abstract={Video Object Segmentation (VOS) is essential for the automated quantitative analysis of complex mouse behaviors. However, multi-mouse segmentation remains challenging, as highly similar visual features, rapid motion patterns, and frequent inter-object occlusions often cause tracking drift and identity (ID) switching in existing VOS methods, particularly over long video sequences. To address these challenges, we propose Refinement-based Multi-Mouse Realtime Video Segmentation (RMMRVS), a closed-loop framework that improves temporal stability and spatial accuracy in long-term multi-object tracking. RMMRVS extends the CUTIE architecture by introducing a feature-aware confidence prediction module that continuously assesses tracking reliability and detects potential drift online. When confidence degradation is detected, an adaptive refinement mechanism is activated, employing Mask2Former to perform high-precision spatial resegmentation. The refined masks are then reinjected into the VOS memory, restoring a stable and reliable reference for subsequent tracking. This “pre-dict-evaluate-correct” strategy effectively suppresses error accumulation and ID switching over extended sequences. Extensive experiments on challenging multi-mouse datasets demonstrate that RMMRVS consistently outperforms baselines in segmentation accuracy and temporal consistency, highlighting its effectiveness and scalability for reliable quantitative behavioral analysis.},
  keywords={Visualization;Accuracy;Tracking;Motion segmentation;Video sequences;Object segmentation;Switches;Streaming media;Reliability;Videos;Video Object Segmentation (VOS);Multi-Object Tracking;Adaptive Correction},
  doi={10.1109/IPMML68499.2025.11407412},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11100168,
  author={Hu, Xiao-Min and Wang, Bing-Hai and Yang, Zhuo},
  booktitle={2025 12th International Conference on Machine Intelligence Theory and Applications (MiTA)}, 
  title={Area Ratio-Based Box Counting Algorithm for Intelligent Inventory in Stacked Goods Environments}, 
  year={2025},
  volume={},
  number={},
  pages={1-9},
  abstract={Inventory management plays a critical role in modern warehouses, but traditional manual counting methods are inefficient and error-prone, especially for large quantities of goods. With advancements in AI, IoT, and computer vision, automated systems have emerged to improve accuracy and efficiency. This paper proposes a novel Area Ratio-Based Box Counting Algorithm (ARBCA) for intelligent inventory in three-dimensional warehouse environments. The algorithm leverages instance segmentation to generate masks for stacked goods and uses area ratios for precise counting. We introduce a customized dataset, the Tobacco Cargo Stacking Dataset (TCSD), and demonstrate the algorithm's effectiveness, achieving an overall inventory accuracy of 93.90% on the TCSD dataset with the Mask2former model. The method addresses challenges such as occlusion and stacking in dark warehouse conditions, showing promise for real-world applications.},
  keywords={Instance segmentation;Computer vision;Accuracy;Error analysis;Stacking;Noise;Manuals;Inventory management;Robustness;Machine intelligence;Inventory management;Warehouse automation;Object counting;Area Ratio-Based Box Counting Algorithm},
  doi={10.1109/MiTA66017.2025.11100168},
  ISSN={},
  month={May},}@INPROCEEDINGS{11196230,
  author={Jia, Chen and Khan, Navid Ali and Mohamad, Abdul Hadi and Wei, Goh Wei and Narputro, Panji},
  booktitle={2025 International Conference on Metaverse and Current Trends in Computing (ICMCTC)}, 
  title={Knife Detection with MDDR Net: An Improved for Small and Indiscernible Object Detection}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={From the viewpoint of the public security and the counter terrorism measures, knife detection is quite important. However, knife detection in real-world settings remains very challenging, particularly in dense environments under occlusion. Additionally, such an environment is very complex, which makes it hard for the knives to be distinguished from background, especially with the knives being small or indiscernible. Traditional techniques for object detection, like YOLO and DETR, hard to detect small or indiscernible objects. Inspired by Deformable DETR, IOC, and Mask2Former, this paper proposes a novel intelligent detection algorithm named MDDR Net (Mask and Deformable Dense Regression Network) to solve the issue of detection for small and indiscernible objects. Mask Attention and Deformable Attention are then integrated to a density regression prediction module (MDDR Net) that can help the model to enhance accuracy in detection and separation of detection from complex backgrounds. To demonstrate, we carry out extensive experiments on the Kaggle Knife Dataset (9,189 images) and show that our method yields an overall mAP of 0.621 (0.903 mAP@0.5 and 0.789 mAP@0.75), being trained with just 6.09 hours for 100 epochs. These results further illustrate the robust performance of MDDR Net in detecting small and unnoticeable knife objects in cluttered geometries.},
  keywords={Training;YOLO;Deformable models;Adaptation models;Accuracy;Weapons;Zero shot learning;Real-time systems;Data models;Tuning;Knife Detection;YOLO;Regression Network;Mask Attention;Deformable Attention},
  doi={10.1109/ICMCTC62214.2025.11196230},
  ISSN={},
  month={April},}

