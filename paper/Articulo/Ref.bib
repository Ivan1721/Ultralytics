@INPROCEEDINGS{10865495,
  author={Du, Xueyi and Huang, Wenhui and Min, Huasong},
  booktitle={2024 China Automation Congress (CAC)}, 
  title={SDSLP-YOLO: An End-to-End Model for Simultaneously Detecting Strawberry and Locating Picking Point}, 
  year={2024},
  volume={},
  number={},
  pages={6098-6103},
  abstract={Accurately identifying strawberries and locating picking points are prerequisites for harvesting robots. To address the issues of multiple detections, missed detections, and false detections, as well as inaccurate picking point localization caused by large differences in fruit shape, complex backgrounds, and occlusions during the picking process, this paper proposes a method based on the YOLOv8-pose model. First, a dual-path feature extraction backbone network (LGFBNet) that combines convolution and Transformer is proposed. This module enhances the richness and expressiveness of features by coupling global and local features, effectively solving the issue of multiple detections caused by large differences in fruit shape. Secondly, CBAM is introduced into the neck of the network, allowing the network to focus more on the distinguishing features between the strawberries and the background, effectively addressing the missed and false detections caused by complex backgrounds. Finally, the NWD-CIoU weighted loss function is introduced, where the scale-balancing property of NWD compensates for the sensitivity of CIoU to positional shifts, reducing the additional missed detection rate caused by severe occlusions. Experimental results show that the proposed method achieves an average precision (mAP-obj) of 88.3% for strawberry detection and an average precision (mAP-kp) of 74.2% for keypoint detection, which are 1.7% and 3% higher than YOLOv8-pose, respectively. In summary, this method has significant theoretical and practical implications for tasks such as strawberry recognition and picking point localization in complex environments.},
  keywords={Location awareness;Performance evaluation;Sensitivity;Shape;Pipelines;Feature extraction;Transformers;Neck;Spatial resolution;Robots;strawberry identification;picking point positioning;yolov8-pose;key point detection},
  doi={10.1109/CAC63892.2024.10865495},
  ISSN={2688-0938},
  month={Nov},}
@INPROCEEDINGS{10865515,
  author={Nan, Qian and Huang, Wenhui and Min, Huasong},
  booktitle={2024 China Automation Congress (CAC)}, 
  title={A Fruit Detection Model in Complex Environments Based on Attention Mechanism and Feature Fusion}, 
  year={2024},
  volume={},
  number={},
  pages={2548-2553},
  abstract={In complex orchard environments, harvesting robots face significant challenges in identifying fruits accurately due to fruits of various sizes, varying degrees of sunlight intensity, and occlusion. To resolve this issue, we propose a fruit detection model in this paper, which is called AMMFF-YOLO and based on the YOLOv8s architecture. Firstly, a small target detection layer is introduced to enhance the model's ability to identify small-sized fruits. Secondly, a light-adaptive module is proposed, which increases spatial dimension information without reducing the channel dimension, enriching the model's perception ability under different sunlight intensities. This module is named C2f-CS, which stands for C2f module based on channel and spatial (CS) attention mechanisms. Furthermore, a context information enhancement module (CIEM) is proposed, which employs dilated convolutions and skip connections to fuse feature information from multiple scales, enlarges the receptive field, and improves the model's ability to recognize target fruits and backgrounds under occlusion. Lastly, the Inner-MPDIoU Loss is used as a bounding box regression loss function to improve the mod-el's localization ability and detection accuracy. In the detection experiments of strawberries, apples, and citrus in complex orchard environments, the detection accuracy of the proposed model is higher than the detection accuracy of other state-of-art models 0.4 % ~ 8.8 %. The experimental results validate the effectiveness of AMMFF-YOLO in fruit detection under complex orchard environments.},
  keywords={Accuracy;Attention mechanisms;Fuses;Target recognition;Lighting;Object detection;Feature extraction;Robustness;Spatial resolution;Robots;object detection;YOLOv8s;feature fusion;attention mechanism;deep learning},
  doi={10.1109/CAC63892.2024.10865515},
  ISSN={2688-0938},
  month={Nov},}
@INPROCEEDINGS{11019965,
  author={Li, Hailong and Yan, Humin},
  booktitle={2025 8th International Conference on Advanced Algorithms and Control Engineering (ICAACE)}, 
  title={Apple Detection in Complex Scenes Based on Improved YOLOv8}, 
  year={2025},
  volume={},
  number={},
  pages={923-926},
  abstract={In order to enable the picking robot to quickly and accurately detect apple fruits of different sizes under complex environments in the orchard (e.g., scenarios with different lighting conditions, fruit leaf occlusion, and dense small targets at long distances), this paper proposes an improved YOLOv8-based algorithm. Firstly, the EMA attention module is integrated into the YOLOv8 network architecture, aiming to enhance the model's focus on the target fruit region, and at the same time, reduce the interference of non-critical features such as background and branch and leaf occlusion, so as to effectively improve the accuracy of fruit detection in the case of occlusion. Secondly, the fusion weighted bidirectional feature pyramid (BiFPN), through weighted feature fusion, enables the network to better learn the features of small targets and reduce the leakage detection rate of small targets. The experimental results prove that the improved algorithm outperforms the original model in most of the metrics, providing a reference for apple detection in complex scenes.},
  keywords={YOLO;Measurement;Accuracy;Target recognition;Lighting;Interference;Network architecture;Feature extraction;Indexes;Robots;component;apple detection;YOLO;EMA;BiFPN},
  doi={10.1109/ICAACE65325.2025.11019965},
  ISSN={},
  month={March},}
@INPROCEEDINGS{10425812,
  author={Kamble, Sneha and Bartakke, Prashant},
  booktitle={2023 Global Conference on Information Technologies and Communications (GCITC)}, 
  title={Smart Refrigerator Management System Using Deep Learning}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={In today’s modern era smart home appliances with new features and technologies plays a vital role to make human life easier. One of the essential and common home appliances is a Refrigerator which helps to preserve Food and Vegetables. There are many Smart Refrigerators available in the Market with integrated cameras WI-FI and Embedded Technologies. By incorporating artificial intelligence and deep learning to enhance the refrigerator’s functioning, smart refrigerators aid in the management of food. Deep Learning Technology is being used to detect the fruits inside the Refrigerator. This is necessary to detect the fruits present inside the refrigerator and keep the track of count present inside it productively and precisely. The goal of this work is to optimize and deploy the trained model in order to capture and categorize images inside the refrigerator in real time. To make fruit classification and recognition more accurate, we created an customised dataset to train and test the model with YOLOv7 deep learning algorithm. Proposed work is also extended to classify the bad and good quality of fruits. The entire system has been implemented using hardware based on NVIDIA Jetson Nano. The suggested system employs a wide-angle camera to capture images towards object recognition and inventory control. It provides an augmented pictures by considering different positions, perspectives, and lighting conditions along with manually created labels. This system also improves the occlusion problem of fruits present inside the inventory. Evaluation of this work reveals that the accuracy is obtained up to 98% with 35 FPS against the YOLOv3 which is attaining an avarage accuracy of 92.45%.},
  keywords={Deep learning;YOLO;Home appliances;Smart homes;Cameras;Real-time systems;Wireless fidelity;Smart Refrigerator;Fruit Detection;Deep learning;YOLOv7;Jetson Nano},
  doi={10.1109/GCITC60406.2023.10425812},
  ISSN={},
  month={Dec},}
@ARTICLE{11370178,
  author={Pereira, Elainne Ladislau F. and Silva, Romário Da Costa and Moura, Flávio Rafael Trindade and Francês, Carlos Renato Lisboa and Cardoso, Diego Lisboa},
  journal={IEEE Access}, 
  title={Pineapples Health Detection Using Deep Learning Models}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Early detection of diseases in agricultural crops remains a significant challenge, especially for small producers who still rely on manual visual inspections—time-consuming, subjective processes with low reproducibility. In pineapple (Ananas comosus) cultivation, phytosanitary monitoring is essential to prevent losses associated with diseases such as fusarium wilt, wet rot, and wilt, as well as infestations by pertussis and nutritional deficiencies. This study presents an innovative automated monitoring approach for detecting visual anomalies in pineapple fruits, based on computer vision techniques applied primarily to images obtained under real field conditions, considering variations in lighting, occlusions, leaf overlap, different fruit orientations, and background interference. Furthermore, a comparative analysis was conducted between different versions of the You Only Look Once model (YOLOv5, YOLOv8, and YOLOv9) to identify the most suitable solution for different production profiles—from small family farms with limited computational resources to large farms with advanced technological infrastructure. The evaluation considered the metrics of Precision, Recall, Average Precision (mAP), and inference time, as well as operational feasibility in low-infrastructure contexts. The results demonstrate consistent performance among the tested models, with YOLOv8 standing out as the most suitable alternative for practical applications in the field and in embedded devices, establishing itself as a robust, accessible, and efficient solution for automated phytosanitary monitoring of pineapple crops.},
  keywords={Crops;YOLO;Monitoring;Computational modeling;Diseases;Farming;Visualization;Lighting;Precision agriculture;Deep learning;Precision agriculture;Fruit disease detection;Crop monitoring;Computer vision},
  doi={10.1109/ACCESS.2026.3660135},
  ISSN={2169-3536},
  month={},}
@INPROCEEDINGS{11233648,
  author={Louis, Fourré and Ooi, Boon-Yaik and Savita, K. Sugathan},
  booktitle={2025 IEEE 11th International Conference on Smart Instrumentation, Measurement and Applications (ICSIMA)}, 
  title={Automated Muskmelon Counting in Real Farm Environment using YOLOv11n}, 
  year={2025},
  volume={},
  number={},
  pages={115-119},
  abstract={Fruit detection and counting in real farm environments remain challenging due to occlusion, variable lighting, and cluttered backgrounds. This study presents a robust computer vision pipeline for accurately detecting, tracking, and counting melons using the You Only Look Once version 11 nano object detection model. To evaluate and enhance performance, multiple dataset versions with different types of annotation (large annotation, front-row strict annotation, and front-row/rear-row annotation distinction) were utilized alongside various image processing pipelines (Roboflow workflows, detection, tracking, and line-counting tracking). Among these, the 4th method, with a line-counting strategy, significantly improved counting accuracy. Our best result was achieved with the front row strict annotation and line counting tracking combination which yielded a counting error rate of just 2.74%. The system was tested on footage captured by an automated guide vehicle in a greenhouse, demonstrating its practical applicability in real-world, non-laboratory agricultural environments. Overall, this work contributes an efficient and accurate melon counting pipeline, laying the foundation for future work such as fruit maturity prediction and disease detection.},
  keywords={YOLO;Training;Computer vision;Accuracy;Annotations;Error analysis;Pipelines;Crops;Servers;Videos;Computer Vision;YOLO;Crops recognition;Object Tracking},
  doi={10.1109/ICSIMA66552.2025.11233648},
  ISSN={2640-6535},
  month={Sep.},}
@INPROCEEDINGS{10525540,
  author={Li, Lin and Duan, Wutian and Chen, Chaobo},
  booktitle={2023 9th International Conference on Mechanical and Electronics Engineering (ICMEE)}, 
  title={An Improved YOLOv5 Algorithm for Apple Object Recognition and Localization}, 
  year={2023},
  volume={},
  number={},
  pages={489-493},
  abstract={In order to address the low apple recognition rate and inaccurate positioning in complex orchard environments, a method to improve the accuracy of the detection algorithm was studied, and an improved YOLOv5-based apple object detection method was proposed. By obtaining the internal parameter matrices of the left and right cameras of a binocular camera, matching the pixel points of the left and right images, and using disparity mapping, the two-dimensional coordinates of the apples were transformed into three-dimensional coordinates, thereby obtaining the three-dimensional coordinates of the apples. Additionally, considering the issues of overlapping and occlusion of apples in complex orchards, the feature fusion network in the original YOLOv5 algorithm was improved to enhance recognition efficiency and accuracy. Experimental results demonstrate that this improved algorithm effectively achieves apple recognition and positioning in complex environments.},
  keywords={YOLO;Location awareness;Three-dimensional displays;Target recognition;Supervised learning;Cameras;Feature extraction;target recognition;Yolov5;positioning},
