@INPROCEEDINGS{11348292,
  author={Zhou, Fanglei and Raza, Ali and Imad, Muhammad and Ali, Raja Hashim},
  booktitle={2025 27th International Multitopic Conference (INMIC)}, 
  title={Deep Learning-Based Tomato Detection from Images for Automated Farming}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Object detection is a critical area of computer vision. It has several applications where it supports many applications in agriculture, food processing, and automation. An important application is the accurate detection of tomatoes, which is essential for improving efficiency as well as in reducing reliance on manual labor in agricultural workflows. While deep learning models have advanced general object detection, there remains limited research focused on tomato identification using modern frameworks. Moreover, researchers have explored enhanced YOLO versions that integrate attention modules to improve fruit detection under occlusion and varying illumination. This study aims to address this gap by developing a detection pipeline based on the YOLOv8 Nano architecture. The dataset was collected from publicly available sources and converted from Pascal VOC annotations to YOLO format to ensure compatibility with the model. The YOLOv8 Nano model was trained for five epochs with a batch size of sixteen and an input resolution of six hundred forty pixels, utilizing GPU acceleration for improved performance. Evaluation results showed a mean average precision of approximately eightynine and high detection confidence across the validation images. These findings confirm that lightweight deep learning models can achieve strong detection capabilities in specialized agricultural tasks. The study contributes a practical approach to automating tomato detection workflows and offers a foundation for further research in efficient agricultural applications.},
  keywords={Deep learning;YOLO;Computer vision;Image resolution;Pipelines;Lighting;Graphics processing units;Manuals;Agriculture;Object recognition;YOLOv8;object detection;tomato detection;deep learning;agriculture;computer vision},
  doi={10.1109/INMIC65900.2025.11348292},
  ISSN={2835-8864},
  month={Dec},}
@ARTICLE{11359681,
  author={Zilong, Liu and Hongbo, Dai},
  journal={IEEE Access}, 
  title={A Lightweight Apple Detection Method in Real Orchard Environments Based on Improved YOLOv8s}, 
  year={2026},
  volume={14},
  number={},
  pages={14302-14314},
  abstract={As a globally popular fruit, apples are highly favored for their rich nutritional components such as dietary fiber, vitamins, and antioxidants. However, during the apple cultivation process, the orchard environment presents complex scenarios including foliage occlusion, fruit overlapping, and illumination changes, which pose severe challenges to fruit recognition and localization in automated picking. Meanwhile, picking robots have high requirements for real - time performance, so the detection model needs to balance light - weight design and high efficiency. To address these issues, this paper proposes an improved algorithm with multi - dimensional optimization. At the feature processing level, by integrating the Convolutional Block Attention Module (CBAM) with the C2f module, a C2f - CBAM structure is constructed to enhance the model’s ability to focus on the target and suppress background interference; the C2PSA module is introduced to effectively reduce the information redundancy of deep - level features and improve the spatial positioning accuracy. At the feature fusion level, the Adaptive Spatial Feature Fusion mechanism (ASFF) is adopted to resolve the information conflicts among multi - scale feature maps, and the GSConv is combined to significantly reduce the computational complexity while maintaining the accuracy. Moreover, at the loss function level, the WIOU loss function is introduced to optimize the anchor box regression process. Compared with CIOU, its dynamic non - monotonic optimization strategy enables the model to exhibit better stability and robustness in complex scenarios such as occlusion. Experimental results show that the improved algorithm effectively improves the detection accuracy and recall rate in occlusion scenarios. While maintaining a relatively small number of model parameters, the mAP index reaches 89.7%, significantly outperforming the original YOLOv8s model and other comparison models.},
  keywords={Accuracy;Feature extraction;Computational modeling;YOLO;Adaptation models;Target recognition;Robustness;Focusing;Neck;Interference;Apple detection;ASFF;CBAM;GSConv;YOLOv8},
  doi={10.1109/ACCESS.2026.3656532},
  ISSN={2169-3536},
  month={},}
@ARTICLE{10906562,
  author={Chen, Bangbang and Tan, Keke and Li, Kun and Ma, Baojian and Liu, Xiangdong},
  journal={IEEE Access}, 
  title={Research on Detection and Counting Method of Green Walnut Based on YOLOv8n-RBP}, 
  year={2025},
  volume={13},
  number={},
  pages={39275-39288},
  abstract={In natural environments, green walnuts often experience occlusion by branches and leaves, fruit overlap, and varying lighting conditions. To address the issues of low detection accuracy, missed detections, and false positives in the YOLO model, this study proposes an improved YOLOv8n-based detection and counting model for green walnuts, named YOLOv8n-RBP. First, a receptive field-concentrated attention module (RFCBAM) is integrated into the backbone network to enhance feature extraction capabilities. Second, a BiFPN-GLSA module is introduced to replace the Path Aggregation Network (PANet) in the neck, improving the fusion of feature layers from the backbone and Neck networks and enhancing the model’s ability to capture both global and local spatial features. Lastly, to address the weak generalization and slow convergence issues of the CIoU loss function in detection tasks, the PIoUv2 loss function is employed to accelerate bounding box regression and improve detection performance. Experimental results demonstrate that the YOLOv8n-RBP model excels across multiple evaluation metrics. Specifically, the model achieves a mean average precision (mAP@0.5) of 82.2% and a recall rate of 72.4%, with a model size of only 4.65 MB, 2.2 million parameters, and 8.3 GFLOPs. Compared to the original YOLOv8n model, the recall rate and mAP@0.5 improve by 2.7% and 2.5%, respectively, while the number of parameters, FLOPs, and model size decrease by 26.7%, 0.6%, and 22.0%, respectively. Further deployment on the NVIDIA Jetson Xavier NX demonstrates the model’s robust performance under natural conditions, indicating its suitability for orchard operations.},
  keywords={Feature extraction;Accuracy;Green products;YOLO;Training;Real-time systems;Neck;Computational modeling;Data models;Data augmentation;Natural environment;green walnut;detection;algorithm improvement;equipment deployment},
  doi={10.1109/ACCESS.2025.3546313},
  ISSN={2169-3536},
  month={},}
@ARTICLE{10707268,
  author={Dai, Jin-Sui and He, Zhi-Qin},
  journal={IEEE Access}, 
  title={Real-Time Recognition and Localization of Kiwifruit Based on Improved YOLOv5s Algorithm}, 
  year={2024},
  volume={12},
  number={},
  pages={156261-156272},
  abstract={To address the recognition and localization challenges posed by occlusion and overlap due to dense fruit growth as well as differences in ripeness, size, morphology, and color in smart Kiwifruit harvesting. This study proposes a real-time Kiwifruit recognition and localization method based on an enhanced YOLOv5s algorithm combined with binocular vision technology. First, data enhancement is implemented in the training strategy to ensure the model’s efficient learning and generalization ability in complex environments; then the Coordinate Attention mechanism is introduced to highlight the key features of the image and improve detail detection; Secondly, the Bidirectional Feature Pyramid Network structure is used to optimize the feature fusion and strengthen the information exchange between different layers through bidirectional connectivity; then, the loss function is optimized to improve the bounding box localization accuracy; and finally, the combined with the binocular vision stereo matching algorithm Semi-Global Block Matching to obtain the spatial location information of Kiwifruit. The experimental results show that the improved YOLOV5s improve the detection accuracy by 6.1%, recall by 5%, and average precision mean by 7.3% compared with its predecessor model. The average recognition of a single image takes only 0.125 seconds. The error of the target’s actual world coordinates and the localization coordinates is within 0.5 cm, mainly concentrated within 0.3 cm, showing the method’s reliability and stability to meet the demand for intelligent Kiwifruit picking.},
  keywords={YOLO;Accuracy;Feature extraction;Location awareness;Data models;Real-time systems;Computational modeling;Training;Robots;Robot kinematics;YOLOv5s model;coordinate attention;bidirectional feature pyramid network;binocular vision;kiwifruit},
  doi={10.1109/ACCESS.2024.3476351},
  ISSN={2169-3536},
  month={},}
@INPROCEEDINGS{11150042,
  author={Fang, Lifa and Gao, Guohua and Li, Jiahao and Zhang, Zihua},
  booktitle={2025 40th Youth Academic Annual Conference of Chinese Association of Automation (YAC)}, 
  title={Lightweight and Efficient Real-Time Tomato Detection Based on Improved YOLOv11 Network}, 
  year={2025},
  volume={},
  number={},
  pages={1971-1976},
  abstract={Faced with the challenge of detecting tomatoes in unstructured environments with dense foliage, overlapping fruits, and varying lighting conditions, this study proposes a high-efficiency, lightweight detection algorithm based on YOLOv11 for real-time detection on low-computation platforms. By adopting MobileNetv4 (small version) as the backbone, the model significantly reduces computational costs while maintaining effective feature extraction. Additionally, the Weighted Bi-directional Feature Pyramid Network (BiFPN) is introduced as the neck to enhance feature fusion, improving detection performance in occlusion, and overlapping scenarios. Experimental results demonstrate that the improved model achieves 96.4% mean Average Precision (mAP), 5.3G FLOPs, 2.1M parameters, and an inference time of 6.5ms, striking a balance between accuracy and efficiency. This research lays the foundation for automated tomato detection, contributing to applications in yield estimation, precision agriculture, and intelligent harvesting systems.},
  keywords={Precision agriculture;Computational modeling;Lighting;Bidirectional control;Feature extraction;Real-time systems;Neck;Computational efficiency;Yield estimation;Detection algorithms;Tomato;Automatic detection;YOLO;MobileNet;BiFPN},
