\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Visibility and Occlusion Analysis}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Training evolution of detection and segmentation metrics for all evaluated models, including YOLO11, YOLO26, and Mask2Former. The figure reports (a) bounding-box mAP50--95, (b) bounding-box recall, (c) mask mAP50--95, and (d) mask recall across training epochs. Mask2Former achieves the highest overall segmentation accuracy and exhibits smoother convergence behavior, particularly in mask-related metrics. YOLO11m remains competitive while providing lower computational complexity and real-time inference capability.}}{11}{}\protected@file@percent }
\newlabel{fig:mask2former_comparison}{{2}{11}{}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Number of validation images per fruit visibility level.}}{11}{}\protected@file@percent }
\newlabel{tab:visibility_counts}{{5}{11}{}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Segmentation performance evolution under different visibility levels for YOLO11m-seg, YOLO26x-seg, and Mask2Former. Validation images were grouped according to object visibility percentages (25\%, 50\%, 75\%, and 100\%). Mask2Former demonstrates higher robustness under severe occlusions. YOLO11m-seg and YOLO26x-seg are closely matched at 25\% and 50\% visibility, while YOLO26x-seg reaches higher mask mAP50--95 than YOLO11m-seg at 75\% and 100\% visibility over most of training. }}{12}{}\protected@file@percent }
\newlabel{fig:visibility_analysis}{{3}{12}{}{figure.3}{}}
